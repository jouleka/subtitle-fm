# --- Core ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Database (Neon Postgres) ---
# Local docker compose maps 5433->5432 to coexist with a locally-installed Postgres.
DATABASE_URL=postgres://subtitle_fm:subtitle_fm@localhost:5433/subtitle_fm

# --- Redis / queue (Upstash) ---
# Local docker compose maps 6380->6379 to coexist with a locally-installed Redis.
REDIS_URL=redis://localhost:6380

# --- Object storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=subtitle-fm-media
R2_BUCKET_PEAKS=subtitle-fm-peaks
R2_PUBLIC_URL=

# --- Auth (Better Auth + Discord OAuth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the api — Better Auth derives the OAuth callback from this.
BETTER_AUTH_URL=http://localhost:3000
# Used by the api for CORS + Better Auth trustedOrigins.
PUBLIC_WEB_URL=http://localhost:5173
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Informational only — Better Auth derives the real callback from BETTER_AUTH_URL:
#   ${BETTER_AUTH_URL}/api/auth/callback/discord
# Register that URL in the Discord developer portal (Application → OAuth2 → Redirects).
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord

# --- GPU worker (RunPod) ---
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
WORKER_WEBHOOK_SECRET=

# --- LLM translation ---
ANTHROPIC_API_KEY=

# --- Collab server (Hocuspocus) ---
COLLAB_PORT=1234
COLLAB_SECRET=

# --- API ---
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000

# --- Web (SvelteKit) ---
PUBLIC_API_URL=http://localhost:3000
PUBLIC_COLLAB_URL=ws://localhost:1234

# --- Stremio addon ---
STREMIO_PORT=7000
STREMIO_PUBLIC_URL=http://localhost:7000

# --- Payments (Lemon Squeezy, MoR) ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
