# --- Core ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:pass@localhost:5432/subtitle_fm

# --- Redis / queue (Upstash) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=subtitle-fm-media
R2_BUCKET_PEAKS=subtitle-fm-peaks
R2_PUBLIC_URL=

# --- Auth (Better Auth + Discord OAuth) ---
AUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback

# --- GPU worker (RunPod) ---
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
WORKER_WEBHOOK_SECRET=

# --- LLM translation ---
ANTHROPIC_API_KEY=

# --- Collab server (Hocuspocus) ---
COLLAB_PORT=1234
COLLAB_SECRET=

# --- API ---
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000

# --- Web (SvelteKit) ---
PUBLIC_API_URL=http://localhost:3000
PUBLIC_COLLAB_URL=ws://localhost:1234

# --- Stremio addon ---
STREMIO_PORT=7000
STREMIO_PUBLIC_URL=http://localhost:7000

# --- Payments (Lemon Squeezy, MoR) ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
