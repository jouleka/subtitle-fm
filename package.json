{
  "name": "subtitle-fm",
  "version": "0.0.0",
  "private": true,
  "description": "Community-driven fansub platform with AI bootstrap",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/stremio",
    "apps/collab",
    "apps/worker-runner",
    "packages/shared",
    "packages/db",
    "packages/ass"
  ],
  "scripts": {
    "dev:api": "bun run --filter @subtitle-fm/api dev",
    "dev:web": "bun run --filter @subtitle-fm/web dev",
    "dev:stremio": "bun run --filter @subtitle-fm/stremio dev",
    "dev:collab": "bun run --filter @subtitle-fm/collab dev",
    "dev:worker": "bun run --filter @subtitle-fm/worker-runner dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "audit": "bun scripts/audit-bun.ts",
    "db:generate": "bun run --filter @subtitle-fm/db generate",
    "db:migrate": "bun run --filter @subtitle-fm/db migrate",
    "smoke": "bun scripts/smoke-test.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "cookie": "0.7.2",
    "nanoid": "3.3.18",
    "path-to-regexp": "0.1.13",
    "postcss": "8.5.26",
    "tmp": "0.2.7",
    "ws": "8.21.3"
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  }
}
